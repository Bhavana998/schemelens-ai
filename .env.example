# SchemeLens AI Environment Configuration

# LLM Provider selection: "mock", "gemini", or "openai"
LLM_PROVIDER=mock

# Model identifiers
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# API Keys (Placeholders only - never commit actual keys)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# OCR Configuration
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# Storage
DATABASE_PATH=data/schemelens.db

# Default Reviewer
DEFAULT_REVIEWER_ID=reviewer_analyst_01
